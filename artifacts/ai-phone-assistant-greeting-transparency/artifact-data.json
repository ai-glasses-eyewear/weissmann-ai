      "it": "In caso di emergenza medica, riagganci e chiami il 144.",
      "en": "In a medical emergency, please hang up and call 144."
    }
  },

  "versionDefinitions": {
    "short": { "blocks": ["greetingAndWho", "disclosure", "escape"], "uiLabel": "Kurzversion" },
    "complete": { "blocks": ["greetingAndWho", "disclosure", "capability", "escape"], "uiLabel": "Vollständige Version" }
