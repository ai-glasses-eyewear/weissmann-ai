  "buildingBlocks": {
    "disclosureTemplate": {
      "de": "hier ist der {selfReference} von {businessName}.",
      "fr": "vous êtes en communication avec {selfReference} de {businessName}.",
      "it": "risponde {selfReference} di {businessName}.",
      "en": "this is the {selfReference} for {businessName}."
    },
    "capabilityTemplate": {
      "de": "Ich kann {capabilityList}.",
      "fr": "Je peux {capabilityList}.",
      "it": "Posso {capabilityList}.",
      "en": "I can {capabilityList}."
    },
    "capabilityJoiner": { "de": " und ", "fr": " et ", "it": " e ", "en": " and " },
    "escapeTemplate": {
      "formal": {
        "de": "Sagen Sie jederzeit „{keyword}“, dann verbinde ich Sie mit unserem Team.",
        "fr": "Dites « {keyword} » à tout moment, je vous mets en relation avec notre équipe.",
        "it": "Dica in qualsiasi momento «{keyword}», la metto subito in contatto con il nostro team.",
        "en": "Just say \"{keyword}\" at any time and I'll connect you with our team."
      },
      "informal": {
        "de": "Sag jederzeit „{keyword}“, dann verbinde ich dich mit unserem Team.",
        "fr": "Dis « {keyword} » à tout moment, je te mets en relation avec notre équipe.",
        "it": "Di' in qualsiasi momento «{keyword}», ti metto subito in contatto con il nostro team.",
        "en": "Just say \"{keyword}\" at any time and I'll connect you with our team."
      }
    },
    "defaultKeyword": { "de": "Notfall", "fr": "urgence", "it": "urgenza", "en": "urgent" },
    "emergencyClauseMedical": {
      "de": "Bei einem medizinischen Notfall legen Sie bitte auf und wählen die 144.",
