---
/**
 * Site header: real Weissmann logo, primary nav, language switcher, demo CTA.
 * Dark translucent bar over the midnight-violet ground.
 * Mobile: CSS-only disclosure via <details>, no JS dependency. The desktop
 * "Company" group and the language switcher use the same <details> pattern
 * (native keyboard support — Enter/Space toggles, Tab moves through panel
 * links — with zero added JS).
 */
import Icon from './Icon.astro';
import { LOCALES, localePrefix, SITE, type Locale } from '../data/site';
import type { LocalePaths } from '../data/routes';
import { pillarNav, companyNav, pricingHref } from '../data/nav';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Locale-independent path (legacy German-slug pages). */
  path?: string;
  /** Localized path per locale — preferred; drives the language switcher. */
  localePaths?: LocalePaths;
  availableLocales?: Locale[];
}
const { locale, path, localePaths, availableLocales = [...LOCALES] } = Astro.props;
const p = localePrefix(locale);

// Per-locale paths for the language switcher, from whichever prop was passed.
const lp: LocalePaths | null = localePaths ?? (path ? { de: path, en: path, it: path, fr: path } : null);
const switchTarget = (l: Locale): string =>
  availableLocales.includes(l) && lp ? `${localePrefix(l)}${lp[l]}` : `${localePrefix(l)}/`;

const pillars = pillarNav(locale); // Services, Industries, AI Academy, Resources
const company = companyNav(locale); // About, Contact — grouped under one "Company" disclosure
const mobileNav = [...pillars, ...company]; // mobile panel stays flat, unchanged
const priceHref = pricingHref(locale);
const currentHref = lp ? `${p}${lp[locale]}` : `${p}/`;
const isCompanyActive = company.some((item) => item.href === currentHref);

const langLabel: Record<Locale, string> = { de: 'DE', en: 'EN', it: 'IT', fr: 'FR' };
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={`${p}/`} aria-label="Weissmann AI – Home">
      <img src="/logo-weissmann-dark.png" alt="Weissmann AI" width="185" height="80" loading="eager" decoding="async" />
    </a>

    <nav class="site-header__nav" aria-label={locale === 'de' ? 'Hauptnavigation' : locale === 'fr' ? 'Navigation principale' : locale === 'it' ? 'Navigazione principale' : 'Main navigation'}>
      {pillars.map((item) => (
        <a href={item.href} aria-current={item.href === currentHref ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <details class="nav-drop">
        <summary aria-current={isCompanyActive ? 'page' : undefined}>
          {t(locale, 'nav.company')}<span class="nav-drop__chev" aria-hidden="true">▾</span>
        </summary>
        <div class="nav-drop__panel">
          {company.map((item) => (
            <a href={item.href} aria-current={item.href === currentHref ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </details>
      <a href={priceHref} aria-current={priceHref === currentHref ? 'page' : undefined}>{t(locale, 'nav.pricing')}</a>
    </nav>

    <div class="site-header__actions">
      <details class="lang-drop">
        <summary aria-label={t(locale, 'lang.switch')}>
          {langLabel[locale]}<span class="nav-drop__chev" aria-hidden="true">▾</span>
        </summary>
        <div class="nav-drop__panel nav-drop__panel--lang">
          {LOCALES.filter((l) => l !== locale).map((l) => (
            <a href={switchTarget(l)} hreflang={l}>{langLabel[l]}</a>
          ))}
        </div>
      </details>
      <a class="btn btn--ghost site-header__call" href={`tel:${SITE.aiPhone}`} data-track="call_ai_live" aria-label={`${t(locale, 'cta.callAi')} ${SITE.aiPhoneDisplay}`}>
        <Icon name="phone" size={14} /><span>{t(locale, 'cta.callAi')}</span>
      </a>
      <a class="btn btn--primary site-header__cta" href={`${p}/kontakt/`} data-track="request_demo">
        {t(locale, 'nav.cta')}
      </a>
    </div>

    <details class="site-header__mobile">
      <summary aria-label={t(locale, 'nav.menu')}>
        <span class="site-header__burger" aria-hidden="true"></span>
      </summary>
      <div class="site-header__mobile-panel">
        <a class="btn btn--primary" href={`tel:${SITE.aiPhone}`} data-track="call_ai_live" aria-label={`${t(locale, 'cta.callAi')} ${SITE.aiPhoneDisplay}`}><Icon name="phone" size={16} />{t(locale, 'cta.callAi')}</a>
        {mobileNav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href={priceHref}>{t(locale, 'nav.pricing')}</a>
        <a class="btn btn--primary" href={`${p}/kontakt/`} data-track="request_demo">{t(locale, 'nav.cta')}</a>
        <div class="lang-switch lang-switch--mobile">
          {LOCALES.map((l) =>
            l === locale
              ? <span aria-current="true">{langLabel[l]}</span>
              : <a href={switchTarget(l)} hreflang={l}>{langLabel[l]}</a>
          )}
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  /* Header gets its own wider constrained container (1440px) rather than the
     site-wide 74rem/1184px .container, per the wider header/hero brief —
     scoped to this component only, not a change to the shared token. */
  .site-header__inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 5.25rem;
  }
  .site-header__brand { display: flex; align-items: center; flex: none; }
  .site-header__brand img { height: 2.1rem; width: auto; }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: var(--space-4);
    margin-inline: auto;
  }
  .site-header__nav > a,
  .site-header__nav .nav-drop > summary {
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
    font-weight: 500;
    font-size: var(--fs-300);
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .site-header__nav > a:hover,
  .site-header__nav .nav-drop > summary:hover { color: var(--ink); text-decoration: none; }
  .site-header__nav > a[aria-current='page'],
  .site-header__nav .nav-drop > summary[aria-current='page'] { color: var(--accent); }

  /* Company + language disclosures share one compact dropdown pattern. */
  .nav-drop, .lang-drop { position: relative; }
  .nav-drop > summary, .lang-drop > summary {
    list-style: none;
    cursor: pointer;
    gap: 0.3rem;
  }
  .nav-drop > summary::-webkit-details-marker,
  .lang-drop > summary::-webkit-details-marker { display: none; }
  .nav-drop__chev { font-size: 0.65em; transition: transform 0.15s ease; }
  .nav-drop[open] .nav-drop__chev, .lang-drop[open] .nav-drop__chev { transform: rotate(180deg); }
  .nav-drop__panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    min-width: 10rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    z-index: 60;
  }
  .nav-drop__panel a {
    padding: 0.55rem 0.7rem;
    border-radius: calc(var(--radius) - 4px);
    color: var(--ink-soft);
    font-size: var(--fs-300);
    white-space: nowrap;
  }
  .nav-drop__panel a:hover { background: var(--paper-soft); color: var(--ink); text-decoration: none; }
  .nav-drop__panel a[aria-current='page'] { color: var(--accent); }

  .site-header__actions { display: none; align-items: center; gap: var(--space-3); margin-left: auto; }

  .lang-drop > summary {
    display: inline-flex; align-items: center;
    min-width: 3.4rem; justify-content: center;
    color: var(--ink-soft); font-weight: 600; font-size: var(--fs-300);
    padding: 0.5rem 0.6rem; border: 1px solid var(--line); border-radius: var(--radius-pill);
    line-height: 1; white-space: nowrap;
  }
  .lang-drop > summary:hover { color: var(--ink); border-color: var(--ink-mute); }
  .nav-drop__panel--lang { min-width: 3.4rem; }
  .nav-drop__panel--lang a { text-align: center; }

  .site-header__call {
    padding: 0.5rem 0.85rem;
    font-size: var(--fs-300);
    font-weight: 500;
    gap: 0.45rem;
    white-space: nowrap;
    color: var(--ink-soft);
    border-color: var(--line);
  }
  .site-header__call:hover { color: var(--ink); }
  .site-header__cta {
    padding: 0.6rem 1.2rem;
    font-size: var(--fs-300);
    white-space: nowrap;
  }

  .site-header__mobile { margin-left: auto; }
  .site-header__mobile summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    border: 1px solid var(--line);
  }
  .site-header__mobile summary::-webkit-details-marker { display: none; }
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--ink);
    position: relative;
  }
  .site-header__burger::before, .site-header__burger::after { content: ""; position: absolute; }
  .site-header__burger::before { top: -6px; }
  .site-header__burger::after { top: 6px; }
  .site-header__mobile-panel {
    position: absolute;
    left: 0; right: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .site-header__mobile-panel a { color: var(--ink); font-weight: 600; }
  .lang-switch { display: flex; gap: 0.75rem; font-size: var(--fs-300); }
  .lang-switch a { color: var(--ink-mute); }
  .lang-switch a:hover { color: var(--ink); text-decoration: none; }
  .lang-switch span[aria-current] { color: var(--ink); font-weight: 700; }
  .lang-switch a, .lang-switch span { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; padding: 0.35rem 0.5rem; }

  @media (min-width: 920px) {
    .site-header__nav, .site-header__actions { display: flex; }
    .site-header__mobile { display: none; }
  }
  /* Narrow-desktop tier (920–1200px): logo + 6 nav items + lang + 2 CTAs is
     tight in this range. Tighten gaps and drop the call button's visible
     label (icon + aria-label only) to reclaim width rather than letting the
     actions group overflow the viewport. */
  @media (min-width: 920px) and (max-width: 1200px) {
    .site-header__nav { gap: var(--space-3); }
    .site-header__actions { gap: var(--space-2); }
    .site-header__call span { display: none; }
    .site-header__call { padding: 0.5rem; }
    .site-header__cta { padding: 0.6rem 0.9rem; }
  }
</style>
